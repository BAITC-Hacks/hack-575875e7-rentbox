# HTTP API работает без ключей. Прогноз требует модуля агента и подтверждённого времени.
RENTBOX_APP_NAME="Windcast Energy API"
RENTBOX_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Готовый контроллер; используется по умолчанию.
RENTBOX_AGENT_FACTORY=src.agent:create_agent

# Заполнить после ответа организаторов, без автоматического назначения UTC.
# RENTBOX_SOURCE_TIMEZONE=...
# RENTBOX_TIMESTAMP_MEANING=interval_start
# Альтернативная семантика: interval_end
RENTBOX_TIME_CONFIGURATION_CONFIRMED=false
# Исследовательский запуск без ложного подтверждения: make demo.
RENTBOX_ALLOW_RESEARCH_TIME_SETTINGS=false

RENTBOX_MAX_PENDING_RUNS=128
RENTBOX_MAX_REPLAY_RUNS=62
RENTBOX_MAX_EVENTS_PER_RUN=500

# По умолчанию файлы берутся относительно корня проекта.
# RENTBOX_DATABASE_PATH=/absolute/path/to/forecasts.duckdb
# RENTBOX_INPUT_DIR=/absolute/path/to/incoming
# RENTBOX_AUDIT_FILE=/absolute/path/to/data-audit.json

BACKEND_PORT=8000

# Необязательные пояснения через NVIDIA NIM. Ключ хранится только локально.
# Численный прогноз работает без ключа; обучение ВЭС — scripts/train.sh на CPU/CUDA/Brev.
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_TIMEOUT_SECONDS=20

# Помощник сайта: OpenAI GPT-6 Astra (модель фиксирована в backend).
# Достаточно ключа на сервере; без ключа явно показывается обычная справка.
# Никогда не используйте NEXT_PUBLIC_ для секретов.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HELPER_ENABLED=true
OPENAI_HELPER_REASONING_EFFORT=low
OPENAI_HELPER_TIMEOUT_SECONDS=40
