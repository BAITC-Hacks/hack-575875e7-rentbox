# HTTP API работает без ключей. Прогноз требует модуля агента и подтверждённого времени.
RENTBOX_APP_NAME="RentBox Energy API"
RENTBOX_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Фабрика Python-модуля коллеги. Имя — пример интерфейса, модуль пока не добавлен.
# RENTBOX_AGENT_FACTORY=src.agent:create_agent

# Заполнить после ответа организаторов, без автоматического назначения UTC.
# RENTBOX_SOURCE_TIMEZONE=...
# RENTBOX_TIMESTAMP_MEANING=interval_start
# Альтернативная семантика: interval_end
RENTBOX_TIME_CONFIGURATION_CONFIRMED=false

RENTBOX_MAX_PENDING_RUNS=128
RENTBOX_MAX_REPLAY_RUNS=62
RENTBOX_MAX_EVENTS_PER_RUN=500

# По умолчанию файлы берутся относительно корня проекта.
# RENTBOX_DATABASE_PATH=/absolute/path/to/forecasts.duckdb
# RENTBOX_INPUT_DIR=/absolute/path/to/incoming
# RENTBOX_AUDIT_FILE=/absolute/path/to/data-audit.json

BACKEND_PORT=8000
