  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "stage": {
            "type": "string",
            "enum": [
              "validate",
              "weather",
              "prepare",
              "model",
              "predict",
              "review",
              "save"
            ],
            "title": "Stage"
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ],
            "title": "Level"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "stage",
          "level",
          "message"
        ],
        "title": "AgentEvent"
      },
      "DataSummary": {
        "properties": {
          "unit": {
            "type": "string",
            "const": "normalized_power",
            "title": "Unit",
            "default": "normalized_power"
          },
          "time_configuration": {
            "$ref": "#/components/schemas/TimeConfiguration"
          },
          "turbines": {
            "items": {
              "$ref": "#/components/schemas/TurbineDataSummary"
            },
            "type": "array",
            "title": "Turbines"
          },
          "february_actuals_available": {
            "type": "boolean",
            "title": "February Actuals Available"
          },
          "february_metrics": {
            "type": "null",
            "title": "February Metrics"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time_configuration",
          "turbines",
          "february_actuals_available",
          "warnings"
        ],
        "title": "DataSummary"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ForecastAnalysis": {
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "ForecastAnalysis"
      },
      "ForecastPoint": {
        "properties": {
          "valid_time": {
            "type": "string",
            "format": "date-time",
            "title": "Valid Time"
          },
          "lead_hour": {
            "type": "integer",
            "maximum": 48.0,
            "minimum": 1.0,
            "title": "Lead Hour"
          },
          "predicted_power": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Predicted Power"
          },
          "weather_inputs": {
            "items": {
              "$ref": "#/components/schemas/WeatherInput"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Weather Inputs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "valid_time",
          "lead_hour",
          "predicted_power",
          "weather_inputs"
        ],
        "title": "ForecastPoint"
      },
      "ForecastRead": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              24,
              48
            ],
            "title": "Horizon Hours"
          },
          "unit": {
            "type": "string",
            "const": "normalized_power",
            "title": "Unit",
            "default": "normalized_power"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "training_data_available_until": {
            "type": "string",
            "format": "date-time",
            "title": "Training Data Available Until"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/ForecastSeries"
            },
            "type": "array",
            "title": "Series"
          },
          "analysis": {
            "$ref": "#/components/schemas/ForecastAnalysis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "as_of",
          "horizon_hours",
          "model_version",
          "training_data_available_until",
          "series",
          "analysis"
        ],
        "title": "ForecastRead"
      },
      "ForecastRunCreate": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              24,
              48
            ],
            "title": "Horizon Hours",
